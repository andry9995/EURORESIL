APP_ENV=dev
APP_SECRET=changez_cette_valeur_en_production_32chars

# MariaDB — remplacer par vos identifiants
DATABASE_URL="mysql://euroresil_user:MOT_DE_PASSE@127.0.0.1:3306/euroresil?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# Mailer (Brevo, Postmark, SMTP...)
MAILER_DSN=smtp://user:pass@smtp.exemple.fr:587

# Universign
UNIVERSIGN_API_URL=https://api.universign.com/v1
UNIVERSIGN_API_KEY=votre_cle_api_universign
UNIVERSIGN_WEBHOOK_SECRET=votre_secret_hmac

# Letreco
LETRECO_API_URL=https://api.letreco.fr/v1
LETRECO_API_KEY=votre_cle_api_letreco
LETRECO_WEBHOOK_SECRET=votre_secret_hmac

# Stripe (packs)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL publique de l'application
APP_URL=https://app.euroresil.fr
