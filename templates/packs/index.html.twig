{% extends 'base.html.twig' %}
{% block title %}Mes packs — EURORESIL{% endblock %}
{% block body %}
    <div class="pricing wrap">
        <div class="head">
            <h2>Des packs <span style="color:var(--blue)">degressifs</span></h2>
            <p>
                Plus vous envoyez de recommandés, moins chaque envoi vous coûte. Sans abonnement — vous payez uniquement à l’usage.
            </p>
        </div>
        <div class="cred-banner">
            Votre solde : <strong>{{ app.user.credits }}</strong> recommandés disponibles
        </div>
        <div class="calc">
            <div class="qty">
                <div>
                    <span class="tierbadge" id="tierBadge">Tarif avantage</span>
                    <div style="font-size:13px;color:var(--ink-soft)">Nombre de recommandés</div>
                </div>
                <div class="big" id="qtyVal">50</div>
            </div>
            <input type="range" min="10" max="1000" step="10" value="50" id="qtySlider">
            <div class="tiers"><span>10</span><span>250</span><span>500</span><span>750</span><span>1000</span></div>
            <div class="calc-out">
                <div class="o">
                    <div class="v" id="unitVal">3,90 €</div>
                    <div class="k">par recommandé</div>
                </div>
                <div class="o">
                    <div class="v" id="totalVal">195 €</div>
                    <div class="k">total HT</div>
                </div>
                <div class="o save">
                    <div class="v" id="saveVal">50 €</div>
                    <div class="k">d’économie</div>
                </div>
            </div>
            <form method="post" action="{{ path('app_packs_purchase') }}" id="buyForm">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('packs_purchase') }}">
                <input type="hidden" name="qty" id="buyQty" value="50">
                <button class="btn btn-primary btn-block" type="button" id="btnBuy">Acheter ce pack</button>
            </form>
        </div>
        <div class="packs">
            {% for tier in pricingGrid %}
                <div class="pack-card pack {% if tier.label == 'Avantage' %}pop{% endif %}" data-qty="{{ tier.min }}">
                    {% if tier.label == 'Avantage' %}
                        <div class="flag">Populaire</div>{% endif %}
                    <div class="pq">{{ tier.min }}</div>
                    <div class="pl">{{ tier.label }}</div>
                    <div class="pu">{{ tier.price|number_format(2,',','') }} €</div>
                    <div class="pt">/ recommandé HT</div>
                </div>
            {% endfor %}
        </div>
        <div class="panel" style="max-width:900px;margin:46px auto 0">
            <div class="panel-top"><h3>Historique de vos achats</h3></div>
            <table>
                <thead>
                <tr>
                    <th>N° facture</th>
                    <th>Date</th>
                    <th>Pack</th>
                    <th>Montant TTC</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                {% for invoice in invoices %}
                    <tr>
                        <td>{{ invoice.invoiceNumber }}</td>
                        <td>{{ invoice.issuedAt|date('d/m/Y') }}</td>
                        <td>{{ invoice.pack ? invoice.pack.qtyPurchased~' recommandés' : '-' }}</td>
                        <td>{{ invoice.amountTtc|number_format(2,',','') }} €</td>
                        <td>
                            {% if invoice.paidAt %}
                                <a class="btn btn-pdf" href="{{ path('app_download', {id: invoice.document.id}) }}" target="_blank">PDF</a>
                            {% else %}
                                <a
                                        href="{{ path('app_packs_continue_purchase', {id: invoice.id}) }}"
                                        class="btn btn-pdf"
                                >
                                    Continuer le paiement
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align:center;padding:24px;color:var(--ink-soft)">Aucun achat pour le
                            moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        const pricingGrid = {{ pricingGrid|json_encode|raw }};
    </script>
    {{ importmap('packs') }}
{% endblock %}