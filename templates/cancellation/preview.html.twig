{% extends 'base.html.twig' %}
{% block title %}Recapitulatif — EURORESIL{% endblock %}

{% block body %}
    <meta name="csrf-token" content="{{ csrf_token('cancellation_send') }}">

    <div class="wizard wrap" style="max-width:1100px">

        {% include 'cancellation/partials/_stepper.html.twig' %}

        <h2>Recapitulatif &amp; envoi</h2>
        <p class="sub">Verifiez, ajoutez vos pieces si necessaire, puis envoyez en recommande electronique qualifie.</p>

        <div class="recap-grid">
            <div class="recap-col">
                {% include 'cancellation/partials/_preview_subscriber.html.twig' %}
                {% include 'cancellation/partials/_preview_contract.html.twig' %}
                {% include 'cancellation/partials/_preview_extra_text.html.twig' %}
                {% include 'cancellation/partials/_preview_attachments.html.twig' %}
            </div>

            <div class="letter-col">
                {% include 'cancellation/partials/_preview_letter.html.twig' %}
            </div>
        </div>

        <div class="nav-btns" style="margin-top:0">
            <a class="btn btn-ghost" href="{{ path('app_cancellation_contract_detail', {id: cancellation.id}) }}">Retour</a>
            <button class="btn btn-primary" id="sendBtn"
                    onclick="sendLre('{{ cancellation.id }}','{{ path('app_cancellation_send', {id: cancellation.id}) }}')">
                Envoyer en LRE qualifiee
            </button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('preview') }}
{% endblock %}