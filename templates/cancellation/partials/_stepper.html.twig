<div class="stepper">
    <div class="sg {% if app.request.attributes.get('_route') == 'app_cancellation_subscriber' %}active{% endif %}">
        <div class="dot">1</div>
        <div class="lbl">Souscripteur</div>
    </div>
    <div class="sg {% if app.request.attributes.get('_route') == 'app_cancellation_insurer' %}active{% endif %}">
        <div class="dot">2</div>
        <div class="lbl">Assureur</div>
    </div>
    <div class="sg {% if app.request.attributes.get('_route') == 'app_cancellation_contract_type' or app.request.attributes.get('_route') == 'app_cancellation_contract_detail' %}active{% endif %}">
        <div class="dot">3</div>
        <div class="lbl">Contrat</div>
    </div>
    <div class="sg {% if app.request.attributes.get('_route') == 'app_cancellation_preview' %}active{% endif %}">
        <div class="dot">4</div>
        <div class="lbl">Envoi</div>
    </div>
</div>