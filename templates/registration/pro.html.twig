{% extends 'base_public.html.twig' %}

{% block title %}Compte professionnel — EURORESIL{% endblock %}

{% block body %}
  <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px">
    <div class="auth-card" style="width:100%;max-width:460px;max-height:94vh;overflow-y:auto">
      <h3>Compte professionnel</h3>
      <p class="desc">Ouvert à tous les professionnels qui envoient des recommandés.</p>

      {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

      {{ form_errors(form) }}

      <div class="field">
        {{ form_label(form.profession, 'Profession *') }}
        {{ form_widget(form.profession, {
          'id': 'profSelect',
          'attr': {'onchange': 'adaptReg(this.value)'}
        }) }}
        <div class="invalid-feedback d-block small mt-1">
          {{ form_errors(form.profession, {'attr': {'class': 'list-unstyled'}}) }}
        </div>
      </div>

      <div class="field">
        {{ form_label(form.raisonSociale, 'Raison sociale *') }}
        {{ form_widget(form.raisonSociale, {'attr': {'placeholder': 'Cabinet Durand & Associes'}}) }}
        <div class="invalid-feedback d-block small mt-1">
          {{ form_errors(form.raisonSociale) }}
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          {{ form_label(form.registryNumber, 'N° ORIAS *', {'label_attr': {'id': 'regLabel'}}) }}
          {{ form_widget(form.registryNumber, {
            'id': 'regInput',
            'attr': {'placeholder': '07 0XX XXX'}
          }) }}
          <div class="invalid-feedback d-block small mt-1">
            {{ form_errors(form.registryNumber) }}
          </div>
        </div>

        <div class="field">
          {{ form_label(form.siret, 'SIRET') }}
          {{ form_widget(form.siret, {'attr': {'placeholder': '123 456 789 00012'}}) }}
          <div class="invalid-feedback d-block small mt-1">
            {{ form_errors(form.siret) }}
          </div>
        </div>
      </div>

      <div class="field">
        {{ form_label(form.email, 'Email professionnel *') }}
        {{ form_widget(form.email, {'attr': {'placeholder': 'contact@cabinet.fr'}}) }}
        <div class="invalid-feedback d-block small mt-1">
          {{ form_errors(form.email) }}
        </div>
      </div>

      <div class="field">
        <label for="{{ form.plainPassword.vars.id }}">
          Mot de passe * <small style="font-weight:400;color:var(--ink-soft)">(8 car. min.)</small>
        </label>
        {{ form_widget(form.plainPassword, {'attr': {'placeholder': '...', 'minlength': '8'}}) }}
        <div class="invalid-feedback d-block small mt-1">
          {{ form_errors(form.plainPassword) }}
        </div>
      </div>

      {% for type, messages in app.flashes %}
        {% for msg in messages %}
          <div class="flash flash-{{ type }}">{{ msg }}</div>
        {% endfor %}
      {% endfor %}

      <button class="btn btn-primary btn-block" type="submit">Créer mon compte</button>

      {{ form_end(form) }}

      <p class="auth-foot"><a class="auth-link" href="{{ path('app_register_choice') }}">Changer de profil</a></p>
    </div>
  </div>

  <script>
    const regMap = {
      courtier: ['N° ORIAS *', '07 0XX XXX'],
      avocat: ['Barreau de rattachement', 'Ex : Paris'],
      syndic: ['Carte professionnelle G (CCI)', 'N° carte'],
      adb: ['Carte professionnelle G (CCI)', 'N° carte'],
      expert: ["N° Ordre (OEC)", 'N° OEC'],
      autre: ['Ref. professionnelle', '(optionnel)']
    };

    function adaptReg(v) {
      const m = regMap[v] || regMap.autre;
      const labelEl = document.getElementById('regLabel');
      const inputEl = document.getElementById('regInput');

      if (labelEl && inputEl) {
        labelEl.innerHTML = m[0];
        inputEl.placeholder = m[1];
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const profSelect = document.getElementById('profSelect');
      if (profSelect) {
        adaptReg(profSelect.value);
      }
    });
  </script>
{% endblock %}