{% extends 'base_public.html.twig' %}
{% block title %}Reinitialiser le mot de passe — EURORESIL{% endblock %}
{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px">
  <div class="auth-card" style="width:100%;max-width:420px">
    <h3>Nouveau mot de passe</h3>
    <p class="desc">Entrez le code recu par email puis choisissez un nouveau mot de passe.</p>
    {% for type, messages in app.flashes %}{% for msg in messages %}<div class="flash flash-{{ type }}">{{ msg }}</div>{% endfor %}{% endfor %}
    <form method="post" id="codeForm">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
      <input type="hidden" name="code" id="codeHidden">
      <label style="font-weight:600;font-size:14px;display:block;margin-bottom:8px">Code de verification</label>
      <div class="code-row">
        <input class="code-input" maxlength="1" inputmode="numeric">
        <input class="code-input" maxlength="1" inputmode="numeric">
        <input class="code-input" maxlength="1" inputmode="numeric">
        <input class="code-input" maxlength="1" inputmode="numeric">
        <input class="code-input" maxlength="1" inputmode="numeric">
        <input class="code-input" maxlength="1" inputmode="numeric">
      </div>
      <div class="field" style="margin-top:18px"><label>Nouveau mot de passe *</label>
        <input type="password" name="password" required placeholder="..." minlength="8"></div>
      <button class="btn btn-primary btn-block" type="submit">Reinitialiser</button>
    </form>
    <p class="auth-foot"><a class="auth-link" href="{{ path('app_login') }}">Retour a la connexion</a></p>
  </div>
</div>
<script>
document.querySelectorAll('.code-input').forEach((el,i,arr)=>{el.addEventListener('input',()=>{if(el.value&&arr[i+1])arr[i+1].focus();});});
document.getElementById('codeForm').addEventListener('submit',function(){
  document.getElementById('codeHidden').value=[...document.querySelectorAll('.code-input')].map(e=>e.value).join('');});
</script>
{% endblock %}
