{% extends 'base_public.html.twig' %}
{% block title %}Mot de passe oublié — EURORESIL{% endblock %}
{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px">
  <div class="auth-card" style="width:100%;max-width:420px">
    <h3>Mot de passe oublié</h3>
    <p class="desc">Saisissez votre adresse e-mail pour recevoir un code de réinitialisation.</p>
    <form method="post">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
      <div class="field"><label>Email</label><input type="email" name="email" placeholder="vous@email.fr" required></div>
      <button class="btn btn-primary btn-block" type="submit">Envoyer le code</button>
    </form>
    <p class="auth-foot"><a class="auth-link" href="{{ path('app_login') }}">Retour a la connexion</a></p>
  </div>
</div>
{% endblock %}
