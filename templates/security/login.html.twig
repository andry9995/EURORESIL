{% extends 'base_public.html.twig' %}
{% block title %}Connexion — EURORESIL{% endblock %}
{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px">
  <div class="auth-card" style="width:100%;max-width:420px">
    <div style="text-align:center;margin-bottom:24px">
      <span style="font-size:26px;font-family:'Bricolage Grotesque',sans-serif;font-weight:800">EURO<b style="color:var(--blue)">RESIL</b></span>
    </div>
    <h3>Connexion</h3>
    <p class="desc">Accédez à votre espace EURORESIL.</p>
    {% for type, messages in app.flashes %}
      {% for msg in messages %}
        <div class="flash flash-{{ type }}">
          {{ msg }}
        </div>
      {% endfor %}
    {% endfor %}
    {% if error %}
      <div class="flash flash-error">
      {{ error.messageKey|trans(error.messageData,'security') }}
      </div>
    {% endif %}
    <form method="post" action="{{ path('app_login') }}">
      <div class="field"><label>Email</label>
        <input type="email" name="_username" value="{{ last_username }}" required placeholder="vous@email.fr">
      </div>
      <div class="field" style="margin-bottom:22px"><label>Mot de passe</label>
        <input type="password" name="_password" required placeholder="…">
      </div>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
      <button class="btn btn-primary btn-block" style="letter-spacing:.04em" type="submit">VALIDER</button>
    </form>
    <div style="text-align:center;margin-top:20px;display:flex;flex-direction:column;gap:11px">
      <a class="auth-link" href="{{ path('app_register_choice') }}">Créer mon compte</a>
      <a class="auth-link" href="{{ path('app_forgot_password') }}">Mot de passe oublié</a>
    </div>
  </div>
</div>
{% endblock %}
