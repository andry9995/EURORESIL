{% extends 'base.html.twig' %}
{% block title %}Envoye — EURORESIL{% endblock %}
{% block body %}
<div class="wizard wrap">
  <div class="success">
    <div class="check-big"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg></div>
    <h2>C'est envoye !</h2>
    <p class="sub">Votre lettre recommandee electronique part vers {{ resiliation.assureurNom }}. Les preuves arrivent en temps reel.</p>
    {% if resiliation.letrecoPliNumber %}
      <p style="font-size:13px;color:var(--ink-soft)">N° de pli : <strong>{{ resiliation.letrecoPliNumber }}</strong></p>
    {% endif %}
    <div class="timeline">
      <div class="tl done"><div class="node"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg></div>
        <div><h5>Signee via Universign</h5><span>Certificat eIDAS</span></div></div>
      <div class="tl cur"><div class="node">2</div>
        <div><h5>Deposee — preuve de depot</h5><span>LRE qualifiee Letreco</span></div></div>
      <div class="tl"><div class="node">3</div>
        <div><h5>Recue / consultee par l'assureur</h5><span>Accuse de reception horodate</span></div></div>
      <div class="tl"><div class="node">4</div>
        <div><h5>Resiliation effective</h5><span>Preuves opposables archivees</span></div></div>
    </div>
    <div class="nav-btns" style="justify-content:center">
      <a class="btn btn-primary" href="{{ path('app_dashboard_detail', {id: resiliation.id}) }}">Voir les preuves</a>
      <a class="btn btn-ghost" href="{{ path('app_home') }}">Retour</a>
    </div>
  </div>
</div>
{% endblock %}
