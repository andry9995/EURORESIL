{% extends 'base.html.twig' %}
{% block title %}Type de contrat — EURORESIL{% endblock %}
{% block body %}
<div class="wizard wrap">
  <div class="stepper">
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Souscripteur</div></div>
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Assureur</div></div>
    <div class="sg active"><div class="dot">3</div><div class="lbl">Contrat</div></div>
    <div class="sg"><div class="dot">4</div><div class="lbl">Envoi</div></div>
  </div>
  <h2>Quel type de contrat resilier chez {{ resiliation.assureurNom }} ?</h2>
  <p class="sub">Selectionnez la nature du contrat.</p>

  <input class="ins-search" id="typeSearch" placeholder="Pour trouver plus facilement votre type de contrat" oninput="filterTypes()">
  <form method="post" action="{{ path('app_wizard_contrat_type', {id: resiliation.id}) }}" id="typeForm">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('wizard_contrat_type') }}">
    <div class="ctype-list" id="typeList">
      {% for type in types_contrat %}
        <button type="button" class="ctype-item" data-key="{{ type.key }}" data-label="{{ type.label }}"
          onclick="selectType('{{ type.key }}','{{ type.label }}')">{{ type.label }}</button>
      {% endfor %}
    </div>
    <input type="hidden" name="type_contrat" id="typeContratVal" value="{{ resiliation.typeContrat ?? '' }}">
  </form>
  <div class="nav-btns">
    <a class="btn btn-ghost" href="{{ path('app_wizard_assureur', {id: resiliation.id}) }}">Retour</a>
  </div>
</div>
<script>
function filterTypes(){
  const q=document.getElementById('typeSearch').value.toLowerCase();
  document.querySelectorAll('.ctype-item').forEach(b=>{
    b.style.display=b.textContent.toLowerCase().includes(q)?'':'none';
  });
}
function selectType(key, label){
  document.getElementById('typeContratVal').value = key;
  document.getElementById('typeForm').submit();
}
</script>
{% endblock %}
