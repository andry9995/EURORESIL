{% extends 'base.html.twig' %}
{% block title %}Recapitulatif — EURORESIL{% endblock %}
{% block body %}
<div class="wizard wrap" style="max-width:1100px">
  <div class="stepper">
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Souscripteur</div></div>
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Assureur</div></div>
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Contrat</div></div>
    <div class="sg active"><div class="dot">4</div><div class="lbl">Envoi</div></div>
  </div>
  <h2>Recapitulatif &amp; envoi</h2>
  <p class="sub">Verifiez, joignez le mandat signe, puis envoyez en recommande electronique qualifie.</p>

  <div class="recap-grid">
    <div class="recap-col">
      <div class="rsec">
        <div class="rsec-head">
          <h4>Souscripteur</h4>
          <a class="btn-mod" href="{{ path('app_wizard_souscripteur', {id: resiliation.id}) }}">Modifier</a>
        </div>
        <div class="rrow"><span class="rl">Nom</span><span class="rv">{{ resiliation.souscripteurNomComplet }}</span></div>
        <div class="rrow"><span class="rl">Adresse</span><span class="rv">{{ resiliation.souscripteur.adresse ?? '' }}, {{ resiliation.souscripteur.cp ?? '' }} {{ resiliation.souscripteur.ville ?? '' }}</span></div>
        <div class="rrow"><span class="rl">Email</span><span class="rv">{{ resiliation.souscripteur.email ?? '' }}</span></div>
      </div>
      <div class="rsec">
        <div class="rsec-head">
          <h4>Le contrat</h4>
          <a class="btn-mod" href="{{ path('app_wizard_contrat_detail', {id: resiliation.id}) }}">Modifier</a>
        </div>
        <div class="rrow"><span class="rl">Assureur</span><span class="rv">{{ resiliation.assureurNom }}</span></div>
        <div class="rrow"><span class="rl">Type</span><span class="rv">{{ resiliation.typeContrat }}</span></div>
        <div class="rrow"><span class="rl">Reference</span><span class="rv">{{ resiliation.contratRef }}</span></div>
        <div class="rrow"><span class="rl">Motif</span><span class="rv">{{ resiliation.motif }}</span></div>
      </div>
      <div class="rsec">
        <div class="rsec-head"><h4>Texte a ajouter a la lettre</h4><span style="font-size:12px;color:var(--ink-soft)">Optionnel</span></div>
        <textarea class="ins-search" id="extraText" rows="3" style="margin-bottom:0" placeholder="Ce texte sera ajoute apres la formule de politesse...">{{ resiliation.extraText ?? '' }}</textarea>
      </div>
      <div class="rsec">
        <div class="rsec-head"><h4>Pieces a joindre</h4></div>
        <p style="font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:8px">Mandat de resiliation :</p>
        <div class="piece-block" id="signBox">
          <div><div class="sig" id="sigText">Signature requise</div><div class="ps">Sera automatiquement joint a la lettre</div></div>
          <button class="btn btn-amber" id="signBtn" onclick="signNow()">Signer via Universign</button>
        </div>
        <p style="font-size:12.5px;font-weight:700;color:var(--ink);margin:14px 0 8px">Autres pieces jointes :</p>
        <button class="addco" style="width:100%;text-align:center" onclick="showToast('Piece ajoutee (demo)')">+ Ajouter un document</button>
      </div>
    </div>
    <div class="letter-col">
      <div class="letter-doc">
        <div class="letter-top">
          <span>Visualisation de la lettre</span>
          <button class="btn-pdf" onclick="showToast('Telechargement en cours...')">Telecharger</button>
        </div>
        <div class="letter-page">
          <div class="letter-sender">{{ resiliation.souscripteurNomComplet }}</div>
          <div style="font-size:11px;color:var(--ink-soft);margin-bottom:16px">{{ resiliation.souscripteur.adresse ?? '' }}, {{ resiliation.souscripteur.cp ?? '' }} {{ resiliation.souscripteur.ville ?? '' }}</div>
          <div class="letter-recipient"><strong>{{ resiliation.assureurNom }}</strong><br><span style="font-size:11px">Service resiliation</span></div>
          <div class="letter-date">Le {{ "now"|date("d/m/Y") }}</div>
          <div class="letter-title">LETTRE RECOMMANDEE ELECTRONIQUE DE RESILIATION</div>
          Madame, Monsieur,<br><br>
          Par la presente lettre recommandee electronique, nous vous informons que nous sommes mandates par
          <strong>{{ resiliation.souscripteurNomComplet }}</strong> afin de resilier le contrat suivant :<br><br>
          <ul style="margin:0 0 12px 16px;padding:0">
            <li>Reference : <span class="ph">{{ resiliation.contratRef }}</span></li>
            <li>Type : <span class="ph">{{ resiliation.typeContrat }}</span></li>
            <li>Motif : <span class="ph">{{ resiliation.motif }}</span></li>
          </ul>
          Nous vous prions d'agreer, Madame, Monsieur, l'expression de nos salutations distinguees.<br><br>
          {% if resiliation.extraText %}<div style="font-style:italic;font-size:11px;color:var(--ink-soft)">{{ resiliation.extraText }}</div>{% endif %}
          <div style="text-align:center;font-style:italic;font-size:11px;color:var(--ink-soft);margin-top:20px;border-top:1px solid var(--line);padding-top:10px">
            (Courrier signe numeriquement par envoi du courrier Letreco)
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="nav-btns" style="margin-top:0">
    <a class="btn btn-ghost" href="{{ path('app_wizard_contrat_detail', {id: resiliation.id}) }}">Retour</a>
    <button class="btn btn-primary" id="sendBtn" disabled
      onclick="sendLre('{{ resiliation.id }}','{{ path('app_wizard_send', {id: resiliation.id}) }}')">
      Envoyer en LRE qualifiee
    </button>
  </div>
</div>
<script>
let signed = false;
function signNow(){
  fetch('{{ path('app_wizard_sign', {id: resiliation.id}) }}',{method:'POST',headers:{'X-CSRF-TOKEN':'{{ csrf_token('wizard_sign') }}'}})
    .then(r=>r.json())
    .then(d=>{
      if(d.signature_url){
        // En prod: ouvrir l'URL Universign dans une iframe ou nouvelle fenetre
        document.getElementById('signBox').classList.add('signed');
        document.getElementById('sigText').textContent='Signe via Universign (eIDAS)';
        document.getElementById('signBtn').style.display='none';
        document.getElementById('sendBtn').disabled=false;
        signed=true;
        showToast('Signature completee via Universign');
      }
    });
}
function sendLre(id, url){
  if(!signed){showToast('Veuillez d abord signer le mandat.');return;}
  fetch(url,{method:'POST',headers:{'X-CSRF-TOKEN':'{{ csrf_token('wizard_send') }}'}})
    .then(r=>r.json())
    .then(d=>{ if(d.redirect) window.location.href=d.redirect; });
}
</script>
{% endblock %}
