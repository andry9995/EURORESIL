{% extends 'base.html.twig' %}
{% block title %}Assureur — EURORESIL{% endblock %}
{% block body %}
<div class="wizard wrap">
  <div class="stepper">
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Souscripteur</div></div>
    <div class="sg active"><div class="dot">2</div><div class="lbl">Assureur</div></div>
    <div class="sg"><div class="dot">3</div><div class="lbl">Contrat</div></div>
    <div class="sg"><div class="dot">4</div><div class="lbl">Envoi</div></div>
  </div>
  <h2 style="text-align:center">Choix de l'assureur</h2>
  <p class="sub" style="text-align:center">Selectionnez l'organisme aupres duquel le contrat a ete souscrit.</p>

  <input class="ins-search" id="insSearch" placeholder="Rechercher un assureur (ex: AXA)"
    value="{{ resiliation.assureurNom ?? '' }}" autocomplete="off">
  <div class="ins-list" id="insList"></div>

  <form method="post" action="{{ path('app_wizard_assureur', {id: resiliation.id}) }}" id="assureurForm">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('wizard_assureur') }}">
    <input type="hidden" name="assureur" id="assureurVal" value="{{ resiliation.assureurNom ?? '' }}">
  </form>

  <p style="text-align:center;font-size:13.5px;color:var(--ink-soft);margin-top:18px">
    Vous ne trouvez pas le bon organisme ? <a class="auth-link" href="#">Demander son ajout</a>
  </p>
  <div class="nav-btns">
    <a class="btn btn-ghost" href="{{ path('app_wizard_souscripteur', {id: resiliation.id}) }}">Retour</a>
    <button class="btn btn-primary" onclick="document.getElementById('assureurForm').submit()" id="nextBtn"
      {% if not resiliation.assureurNom %}disabled{% endif %}>Continuer</button>
  </div>
</div>
<script>
const apiUrl = '{{ path('app_wizard_api_assureurs') }}';
const sel = document.getElementById('assureurVal');
const nextBtn = document.getElementById('nextBtn');
let debounce;

document.getElementById('insSearch').addEventListener('input', function(){
  clearTimeout(debounce);
  debounce = setTimeout(()=>searchAssureurs(this.value), 250);
});

function searchAssureurs(q){
  if(q.length < 2){ document.getElementById('insList').innerHTML=''; return; }
  fetch(apiUrl+'?q='+encodeURIComponent(q))
    .then(r=>r.json())
    .then(data=>{
      document.getElementById('insList').innerHTML = data.map(name=>
        '<button class="ins-item" onclick="selectAssureur(event,''+name.replace(/'/g,"\'")+'')">'+name+'</button>'
      ).join('');
    });
}

function selectAssureur(e, name){
  e.preventDefault();
  document.getElementById('insSearch').value = name;
  document.getElementById('insList').innerHTML = '';
  sel.value = name;
  nextBtn.disabled = false;
  document.getElementById('assureurForm').submit();
}
</script>
{% endblock %}
