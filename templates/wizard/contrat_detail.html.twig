{% extends 'base.html.twig' %}
{% block title %}Contrat — EURORESIL{% endblock %}
{% block body %}
<div class="wizard wrap">
  <div class="stepper">
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Souscripteur</div></div>
    <div class="sg done"><div class="dot">✓</div><div class="lbl">Assureur</div></div>
    <div class="sg active"><div class="dot">3</div><div class="lbl">Contrat</div></div>
    <div class="sg"><div class="dot">4</div><div class="lbl">Envoi</div></div>
  </div>
  <h2>Le contrat a resilier chez {{ resiliation.assureurNom }}</h2>
  <p class="sub">Reference du contrat et motif de la resiliation.</p>

  <form method="post" action="{{ path('app_wizard_contrat_detail', {id: resiliation.id}) }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('wizard_contrat_detail') }}">
    <div class="field"><label>Reference du contrat *</label>
      <input name="contrat_ref" required placeholder="N° du contrat" value="{{ resiliation.contratRef ?? '' }}">
    </div>
    <div class="reassure">
      <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg></div>
      <div>
        <h4>{{ cadre_legal.titre }}</h4>
        <p>{{ cadre_legal.texte }}</p>
      </div>
    </div>
    <label style="display:block;font-weight:600;font-size:14px;margin:24px 0 8px">Motif de resiliation</label>
    <div class="motif-list">
      {% for motif in motifs %}
        <label class="motif">
          <input type="radio" name="motif" value="{{ motif }}"
            {% if resiliation.motif == motif %}checked{% endif %}
            onchange="toggleCustom('{{ motif }}')">
          <span>{{ motif }}</span>
        </label>
      {% endfor %}
    </div>
    <div class="field" id="customMotif" style="display:none;margin-top:10px">
      <input name="motif_custom" placeholder="Precisez votre motif de resiliation">
    </div>
    <div class="nav-btns">
      <a class="btn btn-ghost" href="{{ path('app_wizard_contrat_type', {id: resiliation.id}) }}">Retour au choix du type</a>
      <button class="btn btn-primary" type="submit">Voir ma lettre</button>
    </div>
  </form>
</div>
<script>
function toggleCustom(v){ document.getElementById('customMotif').style.display=(v==='Motif personnalise')?'block':'none'; }
</script>
{% endblock %}
