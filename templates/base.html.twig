<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>{% block title %}EURORESIL{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/euroresil.css') }}">
  <style>
    .btn-nav{font-family:inherit;font-weight:600;font-size:13.5px;padding:7px 16px;border-radius:999px;border:none;background:none;color:var(--ink-soft);cursor:pointer;text-decoration:none;transition:.25s;display:inline-block}
    .btn-nav.on,.btn-nav:hover{background:var(--white);color:var(--blue-deep);box-shadow:var(--shadow-sm)}
    .flash{padding:12px 20px;margin:8px auto 0;max-width:1100px;border-radius:10px;font-weight:600;font-size:14px}
    .flash-success{background:#DFF3E6;color:#1c7a45;border:1px solid #b3dfc2}
    .flash-error{background:#FDEAEA;color:#9b1c1c;border:1px solid #f5c6c6}
    .flash-info{background:var(--blue-soft);color:var(--blue-deep);border:1px solid #cdd7f7}
  </style>
  {% block stylesheets %}{% endblock %}
</head>
<body>
{% if app.user %}
<nav>
  <a class="logo" href="{{ path('app_home') }}">
    <span class="tile">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="33 11" transform="rotate(-30 12 12)"/>
        <path d="M14.6 9.4 18 6 M18 6 L14.3 6 M18 6 L18 9.7" stroke="#FFB22E" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="wm">EURO<b>RESIL</b></span>
  </a>
  <div style="display:flex;align-items:center;gap:8px">
    <div class="mode-toggle">
      {% if app.user.profile == 'pro' %}
        <a href="{{ path('app_dashboard') }}" class="btn-nav {% if app.request.pathinfo starts with '/dashboard' %}on{% endif %}">Tableau de bord</a>
      {% endif %}
      <a href="{{ path('app_wizard_souscripteur') }}" class="btn-nav {% if app.request.pathinfo starts with '/wizard' %}on{% endif %}">Resiliation</a>
      <a href="{{ path('app_packs') }}" class="btn-nav {% if app.request.pathinfo starts with '/packs' %}on{% endif %}">Mes packs</a>
    </div>
    <span style="font-size:13px;color:var(--ink-soft);font-weight:600;margin-left:6px">
      <span style="color:var(--blue)">{{ app.user.credits }}</span> credits
    </span>
    <a href="{{ path('app_logout') }}" class="btn-account">Se deconnecter</a>
  </div>
</nav>
{% endif %}
{% for type, messages in app.flashes %}
  {% for message in messages %}
    <div class="flash flash-{{ type }}">{{ message }}</div>
  {% endfor %}
{% endfor %}
<main>{% block body %}{% endblock %}</main>
<div id="toast" class="toast"></div>
{% block javascripts %}<script src="{{ asset('js/euroresil.js') }}"></script>{% endblock %}
</body></html>
